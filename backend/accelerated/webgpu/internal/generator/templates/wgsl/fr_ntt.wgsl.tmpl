{{- /* Fused radix-2 DIT NTT stages over Fr. Dot is the Fr wgslField. */ -}}
{{- $p := .Prefix -}}{{- $T := .Type -}}
{{template "field_types" .}}

// One dispatch performs `stage_count` consecutive radix-2 DIT stages
// starting at `first_stage`, on all vectors of a batch at once.
//
// Stage s pairs the elements whose flat indices differ only in bit s, with
// twiddle omega^(j << (log_n - 1 - s)) where j = index mod 2^s. The stages
// first_stage .. first_stage + stage_count - 1 therefore only mix elements
// whose indices agree outside bits [first_stage, first_stage + stage_count):
// each such "group" of 2^stage_count elements is loaded into workgroup
// memory, transformed with a barrier between stages, and written back. A
// workgroup holds 2 * WORKGROUP_SIZE elements, i.e. one butterfly per thread
// per stage, and handles several groups when the group is smaller.
//
// The load and store phases optionally fold in the neighbouring element-wise
// passes: bit-reversal of the input index (per vector) and multiplications by
// constants (Montgomery conversions, 1/n, coset denominators).
struct Params {
  // total number of elements (vector count * vector size)
  count: u32,
  first_stage: u32,
  // 0 .. log2(2 * WORKGROUP_SIZE); 0 performs the load/store phases only
  stage_count: u32,
  // bit 0: read input at bit-reversed index; bit 1: multiply loaded values by
  // load_scale; bit 2: multiply stored values by store_scale; bit 3: inverse
  // transform (twiddles are omega^-e = -omega^(n/2 - e)).
  flags: u32,
  // log2 of the vector size
  log_n: u32,
  _pad0: u32,
  _pad1: u32,
  _pad2: u32,
  load_scale: array<vec4<u32>, 2>,
  store_scale: array<vec4<u32>, 2>,
}

const NTT_FLAG_BIT_REVERSE: u32 = 1u;
const NTT_FLAG_LOAD_SCALE: u32 = 2u;
const NTT_FLAG_STORE_SCALE: u32 = 4u;
const NTT_FLAG_INVERSE: u32 = 8u;

{{template "field_consts" .}}

@group(0) @binding(0) var<storage, read> input_values: array<u32>;
// omega^i for i < n/2 (Montgomery form)
@group(0) @binding(1) var<storage, read> input_twiddles: array<u32>;
@group(0) @binding(2) var<storage, read_write> output: array<u32>;
@group(0) @binding(3) var<uniform> params: Params;

{{template "field_core" .}}

fn {{$p}}_from_uniform(words: array<vec4<u32>, 2>) -> {{$T}} {
  var z: {{$T}};
{{- range $i := iterate 0 .Limbs}}
  z.limbs[{{$i}}] = words[{{div $i 4}}][{{mod $i 4}}];
{{- end}}
  return z;
}

fn {{$p}}_load(index: u32) -> {{$T}} {
  let base = index * {{.Limbs}}u;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "input_values" "Limbs" .Limbs "Indent" "  " "Var" "z")}}
  return z;
}

fn {{$p}}_load_twiddle(index: u32) -> {{$T}} {
  let base = index * {{.Limbs}}u;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "input_twiddles" "Limbs" .Limbs "Indent" "  " "Var" "z")}}
  return z;
}

fn {{$p}}_store(index: u32, value: {{$T}}) {
  let base = index * {{.Limbs}}u;
{{- template "store_limbs" (dict "Buffer" "output" "Limbs" .Limbs "Indent" "  " "Var" "value")}}
}

// omega^exponent (forward) or omega^-exponent (inverse) for exponent < n/2,
// from the half table: omega^-e = omega^(n/2) * omega^(n/2 - e) = -omega^(n/2 - e).
fn {{$p}}_twiddle(exponent: u32, inverse: bool) -> {{$T}} {
  if (!inverse) {
    return {{$p}}_load_twiddle(exponent);
  }
  let half_mask = (1u << (params.log_n - 1u)) - 1u;
  // (n/2 - e) mod n/2 is 0 for e = 0, where the twiddle is 1 rather than -1.
  let value = {{$p}}_load_twiddle((0u - exponent) & half_mask);
  let negated = {{$p}}_neg(value);
  var z: {{$T}};
{{- range $i := iterate 0 .Limbs}}
  z.limbs[{{$i}}] = select(negated.limbs[{{$i}}], value.limbs[{{$i}}], exponent == 0u);
{{- end}}
  return z;
}

override WORKGROUP_SIZE: u32 = 256;

// 2 * WORKGROUP_SIZE elements: one radix-2 butterfly per thread per stage.
var<workgroup> tile: array<{{$T}}, 2 * WORKGROUP_SIZE>;

// Flat element index of tile slot `slot` (see the header comment): the
// group's index has `stage_count` zero bits inserted at `first_stage`, and the
// position inside the group fills those bits.
fn tile_index(slot: u32, first_group: u32) -> u32 {
  let k = params.stage_count;
  let s0 = params.first_stage;
  let group = first_group + (slot >> k);
  let position = slot & ((1u << k) - 1u);
  let base = ((group >> s0) << (s0 + k)) | (group & ((1u << s0) - 1u));
  return base | (position << s0);
}

@compute @workgroup_size(WORKGROUP_SIZE)
fn fr_ntt_fused_main(
  @builtin(local_invocation_id) local_id: vec3<u32>,
  @builtin(workgroup_id) workgroup_id: vec3<u32>,
  @builtin(num_workgroups) num_workgroups: vec3<u32>,
) {
  let tid = local_id.x;
  let workgroup_index = workgroup_id.x + workgroup_id.y * num_workgroups.x;
  let k = params.stage_count;
  let s0 = params.first_stage;
  let log_n = params.log_n;
  let n_mask = (1u << log_n) - 1u;
  let inverse = (params.flags & NTT_FLAG_INVERSE) != 0u;
  let tile_elements = 2u * WORKGROUP_SIZE;
  let first_group = workgroup_index * (tile_elements >> k);

  // Load 2 * WORKGROUP_SIZE elements (two per thread) into the tile.
  for (var slot = tid; slot < tile_elements; slot = slot + WORKGROUP_SIZE) {
    let index = tile_index(slot, first_group);
    var value = {{$p}}_zero();
    if (index < params.count) {
      var source = index;
      if ((params.flags & NTT_FLAG_BIT_REVERSE) != 0u) {
        let lane = index & n_mask;
        source = (index - lane) | (reverseBits(lane) >> min(32u - log_n, 31u));
      }
      value = {{$p}}_load(source);
      if ((params.flags & NTT_FLAG_LOAD_SCALE) != 0u) {
        value = {{$p}}_mul(value, {{$p}}_from_uniform(params.load_scale));
      }
    }
    tile[slot] = value;
  }
  workgroupBarrier();

  // Butterfly stages: thread `tid` owns butterfly `tid mod half` of local
  // group `tid / half`, where half = 2^(k-1) butterflies per group per stage.
  for (var local_stage = 0u; local_stage < k; local_stage = local_stage + 1u) {
    let stage = s0 + local_stage;
    let half = 1u << (k - 1u);
    let local_group = tid >> (k - 1u);
    let butterfly = tid & (half - 1u);
    let m = 1u << local_stage;
    let j_local = butterfly & (m - 1u);
    let left_position = ((butterfly >> local_stage) << (local_stage + 1u)) | j_local;
    let left_slot = (local_group << k) | left_position;
    let right_slot = left_slot | m;

    let left = tile[left_slot];
    var right = tile[right_slot];
    if (stage != 0u) {
      // twiddle index j = flat index mod 2^stage = low s0 bits of the group | j_local << s0
      let group = first_group + local_group;
      let j = (group & ((1u << s0) - 1u)) | (j_local << s0);
      right = {{$p}}_mul(right, {{$p}}_twiddle(j << (log_n - 1u - stage), inverse));
    }
    tile[left_slot] = {{$p}}_add(left, right);
    tile[right_slot] = {{$p}}_sub(left, right);
    workgroupBarrier();
  }

  for (var slot = tid; slot < tile_elements; slot = slot + WORKGROUP_SIZE) {
    let index = tile_index(slot, first_group);
    if (index < params.count) {
      var value = tile[slot];
      if ((params.flags & NTT_FLAG_STORE_SCALE) != 0u) {
        value = {{$p}}_mul(value, {{$p}}_from_uniform(params.store_scale));
      }
      {{$p}}_store(index, value);
    }
  }
}
