{{- /* Standalone field arithmetic shader. Dot is a wgslField. */ -}}
{{- $p := .Prefix -}}{{- $P := .UPrefix -}}{{- $T := .Type -}}
// curvegpu:section {{.SectionTypes}} begin
{{template "field_types" .}}
// curvegpu:section {{.SectionTypes}} end

struct Params {
  count: u32,
  opcode: u32,
  _pad0: u32,
  _pad1: u32,
}

const {{$P}}_OP_COPY: u32 = 0u;
const {{$P}}_OP_ZERO: u32 = 1u;
const {{$P}}_OP_ONE: u32 = 2u;
const {{$P}}_OP_ADD: u32 = 3u;
const {{$P}}_OP_SUB: u32 = 4u;
const {{$P}}_OP_NEG: u32 = 5u;
const {{$P}}_OP_DOUBLE: u32 = 6u;
const {{$P}}_OP_NORMALIZE: u32 = 7u;
const {{$P}}_OP_EQUAL: u32 = 8u;
const {{$P}}_OP_MUL: u32 = 9u;
const {{$P}}_OP_SQUARE: u32 = 10u;
const {{$P}}_OP_TO_MONT: u32 = 11u;
const {{$P}}_OP_FROM_MONT: u32 = 12u;

// curvegpu:section {{.SectionConsts}} begin
{{template "field_consts" .}}
// curvegpu:section {{.SectionConsts}} end

@group(0) @binding(0) var<storage, read> input_a: array<u32>;
@group(0) @binding(1) var<storage, read> input_b: array<u32>;
@group(0) @binding(2) var<storage, read_write> output: array<u32>;
@group(0) @binding(3) var<uniform> params: Params;

// curvegpu:section {{.SectionCore}} begin
{{template "field_core" .}}
// curvegpu:section {{.SectionCore}} end

fn {{$p}}_dispatch(opcode: u32, a: {{$T}}, b: {{$T}}) -> {{$T}} {
  if (opcode == {{$P}}_OP_COPY) {
    return a;
  }
  if (opcode == {{$P}}_OP_ZERO) {
    return {{$p}}_zero();
  }
  if (opcode == {{$P}}_OP_ONE) {
    return {{$p}}_one();
  }
  if (opcode == {{$P}}_OP_ADD) {
    return {{$p}}_add(a, b);
  }
  if (opcode == {{$P}}_OP_SUB) {
    return {{$p}}_sub(a, b);
  }
  if (opcode == {{$P}}_OP_NEG) {
    return {{$p}}_neg(a);
  }
  if (opcode == {{$P}}_OP_DOUBLE) {
    return {{$p}}_double(a);
  }
  if (opcode == {{$P}}_OP_NORMALIZE) {
    return {{$p}}_normalize(a);
  }
  if (opcode == {{$P}}_OP_EQUAL) {
    return {{$p}}_predicate({{$p}}_equal(a, b));
  }
  if (opcode == {{$P}}_OP_MUL) {
    return {{$p}}_mul(a, b);
  }
  if (opcode == {{$P}}_OP_SQUARE) {
    return {{$p}}_square(a);
  }
  if (opcode == {{$P}}_OP_TO_MONT) {
    return {{$p}}_mul(a, {{$p}}_rsquare_regular());
  }
  if (opcode == {{$P}}_OP_FROM_MONT) {
    return {{$p}}_mul(a, {{$p}}_one_regular());
  }
  return {{$p}}_zero();
}

fn {{$p}}_load_a(index: u32) -> {{$T}} {
  let base = index * {{.Limbs}}u;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "input_a" "Limbs" .Limbs "Indent" "  " "Var" "z")}}
  return z;
}

fn {{$p}}_load_b(index: u32) -> {{$T}} {
  let base = index * {{.Limbs}}u;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "input_b" "Limbs" .Limbs "Indent" "  " "Var" "z")}}
  return z;
}

fn {{$p}}_store(index: u32, value: {{$T}}) {
  let base = index * {{.Limbs}}u;
{{- template "store_limbs" (dict "Buffer" "output" "Limbs" .Limbs "Indent" "  " "Var" "value")}}
}

override WORKGROUP_SIZE: u32 = 64;

@compute @workgroup_size(WORKGROUP_SIZE)
fn {{$p}}_ops_main(@builtin(global_invocation_id) id: vec3<u32>) {
  let i = id.x;
  if (i >= params.count) {
    return;
  }
  {{$p}}_store(i, {{$p}}_dispatch(params.opcode, {{$p}}_load_a(i), {{$p}}_load_b(i)));
}
