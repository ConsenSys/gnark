{{- /* PLONK quotient numerator on one coset of the large domain. Composed after
       the fr_types / fr_constants / fr_core sections of fr_arith.wgsl (see
       web/src/curvegpu/plonk_quotient_module.ts). Dot is the Fr wgslField.

       One dispatch evaluates the numerator on coset `coset_base` for all
       `count` points. Inputs are Montgomery form; the output is Montgomery form
       written directly at the bit-reversed position of the large domain
       (index = reverse(rho*i + coset) over log_total bits), which is the layout
       gnark's prover expects for the numerator. */ -}}
{{- $p := .Prefix -}}{{- $T := .Type -}}{{- $n := .Limbs -}}
struct PlonkQuotientParams {
  count: u32,       // points per coset (small domain size n)
  blind_count: u32, // coefficients per blinding polynomial
  coset_count: u32, // rho = large domain size / n
  coset_base: u32,  // index of the coset evaluated by this dispatch
  log_total: u32,   // log2(rho * n)
  _pad0: u32,
  _pad1: u32,
  _pad2: u32,
}

override COMMITMENT_COUNT: u32 = 0u;

const PLONK_FR_WORDS: u32 = {{$n}}u;
const PLONK_BLIND_COUNT: u32 = 4u;
const PLONK_SCALAR_COUNT: u32 = 7u;

// dynamic vectors: L, R, O, Z, Qk, then the COMMITMENT_COUNT committed values
const PLONK_VEC_L: u32 = 0u;
const PLONK_VEC_R: u32 = 1u;
const PLONK_VEC_O: u32 = 2u;
const PLONK_VEC_Z: u32 = 3u;
const PLONK_VEC_QK: u32 = 4u;
const PLONK_DYNAMIC_BASE_COUNT: u32 = 5u;

// static vectors: Ql, Qr, Qm, Qo, S1, S2, S3, then the COMMITMENT_COUNT selectors Qcp
const PLONK_VEC_QL: u32 = 0u;
const PLONK_VEC_QR: u32 = 1u;
const PLONK_VEC_QM: u32 = 2u;
const PLONK_VEC_QO: u32 = 3u;
const PLONK_VEC_S1: u32 = 4u;
const PLONK_VEC_S2: u32 = 5u;
const PLONK_VEC_S3: u32 = 6u;
const PLONK_STATIC_BASE_COUNT: u32 = 7u;

const PLONK_BLIND_L: u32 = 0u;
const PLONK_BLIND_R: u32 = 1u;
const PLONK_BLIND_O: u32 = 2u;
const PLONK_BLIND_Z: u32 = 3u;

const PLONK_SCALAR_COSET: u32 = 0u;
const PLONK_SCALAR_LAGRANGE_SCALE: u32 = 1u;
const PLONK_SCALAR_CS: u32 = 2u;
const PLONK_SCALAR_CSS: u32 = 3u;
const PLONK_SCALAR_BETA: u32 = 4u;
const PLONK_SCALAR_GAMMA: u32 = 5u;
const PLONK_SCALAR_ALPHA: u32 = 6u;

@group(0) @binding(0) var<storage, read> plonk_dynamic: array<u32>;      // evaluations on the coset
@group(0) @binding(1) var<storage, read> plonk_static: array<u32>;       // evaluations on the coset
@group(0) @binding(2) var<storage, read> plonk_twiddles: array<u32>;     // ω^i of the small domain
@group(0) @binding(3) var<storage, read> plonk_denominators: array<u32>; // 1/(s·ω^i − 1) for this coset
@group(0) @binding(4) var<storage, read> plonk_blinds: array<u32>;       // all cosets
@group(0) @binding(5) var<storage, read> plonk_scalars: array<u32>;      // all cosets
@group(0) @binding(6) var<storage, read_write> plonk_output: array<u32>; // large domain, bit-reversed
@group(0) @binding(7) var<uniform> plonk_params: PlonkQuotientParams;

fn plonk_load_dynamic(vector: u32, index: u32) -> {{$T}} {
  let base = (vector * plonk_params.count + index) * PLONK_FR_WORDS;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "plonk_dynamic" "Limbs" $n "Indent" "  " "Var" "z")}}
  return z;
}

fn plonk_load_static(vector: u32, index: u32) -> {{$T}} {
  let base = (vector * plonk_params.count + index) * PLONK_FR_WORDS;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "plonk_static" "Limbs" $n "Indent" "  " "Var" "z")}}
  return z;
}

fn plonk_load_twiddle(index: u32) -> {{$T}} {
  let base = index * PLONK_FR_WORDS;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "plonk_twiddles" "Limbs" $n "Indent" "  " "Var" "z")}}
  return z;
}

fn plonk_load_denominator(index: u32) -> {{$T}} {
  let base = index * PLONK_FR_WORDS;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "plonk_denominators" "Limbs" $n "Indent" "  " "Var" "z")}}
  return z;
}

fn plonk_load_blind(poly: u32, index: u32) -> {{$T}} {
  let base = (((plonk_params.coset_base * PLONK_BLIND_COUNT + poly) * plonk_params.blind_count) + index) * PLONK_FR_WORDS;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "plonk_blinds" "Limbs" $n "Indent" "  " "Var" "z")}}
  return z;
}

fn plonk_load_scalar(index: u32) -> {{$T}} {
  let base = ((plonk_params.coset_base * PLONK_SCALAR_COUNT) + index) * PLONK_FR_WORDS;
  var z: {{$T}};
{{- template "load_limbs" (dict "Buffer" "plonk_scalars" "Limbs" $n "Indent" "  " "Var" "z")}}
  return z;
}

fn plonk_store(index: u32, value: {{$T}}) {
  // position of (coset, index) in the bit-reversed large domain
  let position = reverseBits(plonk_params.coset_count * index + plonk_params.coset_base) >> (32u - plonk_params.log_total);
  let base = position * PLONK_FR_WORDS;
{{- template "store_limbs" (dict "Buffer" "plonk_output" "Limbs" $n "Indent" "  " "Var" "value")}}
}

// Horner evaluation of a blinding polynomial at `point`.
fn plonk_eval_blind(poly: u32, point: {{$T}}) -> {{$T}} {
  var res = {{$p}}_zero();
  var i = plonk_params.blind_count;
  loop {
    if (i == 0u) {
      break;
    }
    i = i - 1u;
    res = {{$p}}_add({{$p}}_mul(res, point), plonk_load_blind(poly, i));
  }
  return res;
}

fn plonk_evaluate_quotient(index: u32) -> {{$T}} {
  let twiddle = plonk_load_twiddle(index);
  let next_index = (index + 1u) % plonk_params.count;
  let next_twiddle = plonk_load_twiddle(next_index);

  var l = {{$p}}_add(plonk_load_dynamic(PLONK_VEC_L, index), plonk_eval_blind(PLONK_BLIND_L, twiddle));
  var r = {{$p}}_add(plonk_load_dynamic(PLONK_VEC_R, index), plonk_eval_blind(PLONK_BLIND_R, twiddle));
  var o = {{$p}}_add(plonk_load_dynamic(PLONK_VEC_O, index), plonk_eval_blind(PLONK_BLIND_O, twiddle));
  var z = {{$p}}_add(plonk_load_dynamic(PLONK_VEC_Z, index), plonk_eval_blind(PLONK_BLIND_Z, twiddle));
  let zs = {{$p}}_add(plonk_load_dynamic(PLONK_VEC_Z, next_index), plonk_eval_blind(PLONK_BLIND_Z, next_twiddle));

  // gate constraint
  var gate = {{$p}}_mul(plonk_load_static(PLONK_VEC_QL, index), l);
  gate = {{$p}}_add(gate, {{$p}}_mul(plonk_load_static(PLONK_VEC_QR, index), r));
  gate = {{$p}}_add(gate, {{$p}}_mul({{$p}}_mul(plonk_load_static(PLONK_VEC_QM, index), l), r));
  gate = {{$p}}_add(gate, {{$p}}_mul(plonk_load_static(PLONK_VEC_QO, index), o));
  gate = {{$p}}_add(gate, plonk_load_dynamic(PLONK_VEC_QK, index));
  var commitment_index = 0u;
  loop {
    if (commitment_index >= COMMITMENT_COUNT) {
      break;
    }
    let qcp = plonk_load_static(PLONK_STATIC_BASE_COUNT + commitment_index, index);
    let committed = plonk_load_dynamic(PLONK_DYNAMIC_BASE_COUNT + commitment_index, index);
    gate = {{$p}}_add(gate, {{$p}}_mul(qcp, committed));
    commitment_index = commitment_index + 1u;
  }

  // ordering (copy) constraint
  let beta = plonk_load_scalar(PLONK_SCALAR_BETA);
  let gamma = plonk_load_scalar(PLONK_SCALAR_GAMMA);
  let alpha = plonk_load_scalar(PLONK_SCALAR_ALPHA);
  let id = {{$p}}_mul({{$p}}_mul(twiddle, plonk_load_scalar(PLONK_SCALAR_COSET)), beta);

  var a = {{$p}}_add({{$p}}_add(gamma, l), id);
  var b = {{$p}}_add({{$p}}_add({{$p}}_mul(id, plonk_load_scalar(PLONK_SCALAR_CS)), r), gamma);
  var c = {{$p}}_add({{$p}}_add({{$p}}_mul(id, plonk_load_scalar(PLONK_SCALAR_CSS)), o), gamma);
  let right = {{$p}}_mul({{$p}}_mul({{$p}}_mul(a, b), c), z);

  a = {{$p}}_add({{$p}}_add({{$p}}_mul(plonk_load_static(PLONK_VEC_S1, index), beta), l), gamma);
  b = {{$p}}_add({{$p}}_add({{$p}}_mul(plonk_load_static(PLONK_VEC_S2, index), beta), r), gamma);
  c = {{$p}}_add({{$p}}_add({{$p}}_mul(plonk_load_static(PLONK_VEC_S3, index), beta), o), gamma);
  let left = {{$p}}_mul({{$p}}_mul({{$p}}_mul(a, b), c), zs);

  let ordering = {{$p}}_sub(left, right);

  // (Z − 1)·L₁ on the coset
  let lone = {{$p}}_mul(plonk_load_scalar(PLONK_SCALAR_LAGRANGE_SCALE), plonk_load_denominator(index));
  var local = {{$p}}_mul({{$p}}_sub(z, {{$p}}_one()), lone);

  // Horner in alpha: gate + alpha*(ordering + alpha*local)
  local = {{$p}}_add({{$p}}_mul(local, alpha), ordering);
  return {{$p}}_add({{$p}}_mul(local, alpha), gate);
}

override WORKGROUP_SIZE: u32 = 64;

@compute @workgroup_size(WORKGROUP_SIZE)
fn fr_plonk_quotient_main(@builtin(global_invocation_id) id: vec3<u32>) {
  let i = id.x;
  if (i >= plonk_params.count) {
    return;
  }
  plonk_store(i, plonk_evaluate_quotient(i));
}
