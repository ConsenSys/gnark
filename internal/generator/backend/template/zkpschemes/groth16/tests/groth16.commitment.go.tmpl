type singleSecretCommittedCircuit struct {
	One frontend.Variable
}

func (c *singleSecretCommittedCircuit) Define(api frontend.API) error {
	api.AssertIsEqual(c.One, 1)
	commitCompiler, ok := api.(frontend.Committer)
	if !ok {
		return fmt.Errorf("compiler does not commit")
	}
	commit, err := commitCompiler.Commit(c.One)
	if err != nil {
		return err
	}
	api.AssertIsDifferent(commit, 0)
	return nil
}

func setup(t *testing.T, circuit frontend.Circuit) (*cs.R1CS, *{{toLower .CurveID}}groth16.ProvingKey, *{{toLower .CurveID}}groth16.VerifyingKey) {
	_ccs, err := frontend.Compile(ecc.{{.CurveID}}.ScalarField(), r1cs.NewBuilder, circuit)
	assert.NoError(t, err)

	ccs, ok := _ccs.(*cs.R1CS)
	if !assert.True(t, ok) {
		return nil, nil, nil
	}

	pk := new({{toLower .CurveID}}groth16.ProvingKey)
	vk := new({{toLower .CurveID}}groth16.VerifyingKey)
	err = {{toLower .CurveID}}groth16.Setup(ccs, pk, vk)
	assert.NoError(t, err)

	return ccs, pk, vk
}

func prove(t *testing.T, assignment frontend.Circuit, ccs *cs.R1CS, pk *{{toLower .CurveID}}groth16.ProvingKey) (fr.Vector, *{{toLower .CurveID}}groth16.Proof) {
	_witness, err := frontend.NewWitness(assignment, ecc.{{.CurveID}}.ScalarField())
	assert.NoError(t, err)

	proof, err := {{toLower .CurveID}}groth16.Prove(ccs, pk, _witness)
	assert.NoError(t, err)

	public, err := _witness.Public()
	assert.NoError(t, err)
	vector, ok := public.Vector().(fr.Vector)
	if !assert.True(t, ok) {
		return nil, nil
	}
	return vector, proof
}

func test(t *testing.T, circuit frontend.Circuit, assignment frontend.Circuit) {

	ccs, pk, vk := setup(t, circuit)

	public, proof := prove(t, assignment, ccs, pk)

	assert.NoError(t, {{toLower .CurveID}}groth16.Verify(proof, vk, public))
}

func TestSingleSecretCommitted(t *testing.T) {
	circuit := singleSecretCommittedCircuit{}
	assignment := singleSecretCommittedCircuit{One: 1}
	test(t, &circuit, &assignment)
}

