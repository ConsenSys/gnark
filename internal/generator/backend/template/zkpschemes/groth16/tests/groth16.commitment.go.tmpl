type oneSecretOnePublicCommittedCircuit struct {
	One frontend.Variable
	Two frontend.Variable `gnark:",public"`
}

func (c *oneSecretOnePublicCommittedCircuit) Define(api frontend.API) error {
	commitCompiler, ok := api.(frontend.Committer)
	if !ok {
		return fmt.Errorf("compiler does not commit")
	}
	commit, err := commitCompiler.Commit(c.One, c.Two)
	if err != nil {
		return err
	}

	// constrain vars
	api.AssertIsDifferent(commit, 0)
	api.AssertIsEqual(c.One, 1)
	api.AssertIsEqual(c.Two, 2)

	return nil
}

func TestOneSecretOnePublicCommitted(t *testing.T) {
	test(t, &oneSecretOnePublicCommittedCircuit{}, &oneSecretOnePublicCommittedCircuit{
		One: 1,
		Two: 2,
	})
}

type twoSecretCommitmentsCircuit struct {
	One frontend.Variable
	Two frontend.Variable
}

func (c *twoSecretCommitmentsCircuit) Define(api frontend.API) error {
	commitCompiler, ok := api.(frontend.Committer)
	if !ok {
		return fmt.Errorf("compiler does not commit")
	}
	commit1, err := commitCompiler.Commit(c.One)
	if err != nil {
	        return err
	}
	commit2, err := commitCompiler.Commit(c.Two)
	if err != nil {
	        return err
	}
	// constrain vars
	api.AssertIsDifferent(commit1, 0)
	api.AssertIsDifferent(commit2, 0)
	return nil
}

func TestTwoSecretCommitments(t *testing.T) {
	test(t, &twoSecretCommitmentsCircuit{}, &twoSecretCommitmentsCircuit{
		One: 1,
		Two: 2,
	})
}

func TestVerifyCommitmentCountInvariant(t *testing.T) {
	testCases := []struct {
		name             string
		circuit          frontend.Circuit
		assignment       frontend.Circuit
		proofCommitments int
		expectedErr      string
	}{
		{
			name:             "circuit_no_commitment_proof_has_commitment",
			circuit:          &noCommitmentCircuit{},
			assignment:       &noCommitmentCircuit{One: 1},
			proofCommitments: 1,
			expectedErr:      "invalid proof: got 1 commitments, expected 0",
		},
		{
			name:             "circuit_one_commitment_proof_has_no_commitment",
			circuit:          &singleSecretCommittedCircuit{},
			assignment:       &singleSecretCommittedCircuit{One: 1},
			proofCommitments: 0,
			expectedErr:      "invalid proof: got 0 commitments, expected 1",
		},
		{
			name:             "circuit_one_commitment_proof_has_two_commitments",
			circuit:          &singleSecretCommittedCircuit{},
			assignment:       &singleSecretCommittedCircuit{One: 1},
			proofCommitments: 2,
			expectedErr:      "invalid proof: got 2 commitments, expected 1",
		},
		{
			name:             "circuit_two_commitment_proof_has_single_commitment",
			circuit:          &twoSecretCommitmentsCircuit{},
			assignment:       &twoSecretCommitmentsCircuit{One: 1, Two: 2},
			proofCommitments: 1,
			expectedErr:      "invalid proof: got 1 commitments, expected 2",
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			_r1cs, pk, vk := setup(t, tc.circuit)
			public, proof := prove(t, tc.assignment, _r1cs, pk)

			if len(proof.Commitments) > tc.proofCommitments {
				proof.Commitments = proof.Commitments[:tc.proofCommitments]
			}
			for len(proof.Commitments) < tc.proofCommitments {
				var s fr.Element
				_, err := s.SetRandom()
				assert.NoError(t, err)
				var sBigInt big.Int
				s.BigInt(&sBigInt)
				var randomG1El curve.G1Affine
				randomG1El.ScalarMultiplicationBase(&sBigInt)
				proof.Commitments = append(proof.Commitments, randomG1El)
			}

			var err error
			ok := assert.NotPanics(t, func() {
				err = {{toLower .CurveID}}groth16.Verify(proof, vk, public)
			}, "Verify should reject malformed commitment counts without panicking")
			if ok {
				assert.ErrorContains(t, err, tc.expectedErr)
			}
		})
	}
}

// reading a key into an object that was already populated must replace its
// commitment keys instead of appending to them.
func TestReadFromReusedKeys(t *testing.T) {
	_, pk, vk := setup(t, &singleSecretCommittedCircuit{})

	var vkBuf, pkBuf, dumpBuf bytes.Buffer
	_, err := vk.WriteTo(&vkBuf)
	assert.NoError(t, err)
	_, err = pk.WriteTo(&pkBuf)
	assert.NoError(t, err)
	assert.NoError(t, pk.WriteDump(&dumpBuf))

	var vk2 {{toLower .CurveID}}groth16.VerifyingKey
	var pk2, pk3 {{toLower .CurveID}}groth16.ProvingKey
	for i := 0; i < 2; i++ {
		_, err = vk2.ReadFrom(bytes.NewReader(vkBuf.Bytes()))
		assert.NoError(t, err, "vk ReadFrom #%d", i)
		_, err = pk2.ReadFrom(bytes.NewReader(pkBuf.Bytes()))
		assert.NoError(t, err, "pk ReadFrom #%d", i)
		assert.NoError(t, pk3.ReadDump(bytes.NewReader(dumpBuf.Bytes())), "pk ReadDump #%d", i)
	}
	assert.Len(t, vk2.CommitmentKeys, 1)
	assert.Len(t, pk2.CommitmentKeys, 1)
	assert.Len(t, pk3.CommitmentKeys, 1)
}
