func test(t *testing.T, circuit gkrcore.RawCircuit) {
	testWithSchedule(t, circuit, nil)
}

func testWithSchedule(t *testing.T, circuit gkrcore.RawCircuit, schedule constraint.GkrProvingSchedule) {
	gCircuit, sCircuit := cache.Compile(t, circuit)

	schedules := []constraint.GkrProvingSchedule{schedule}
	if schedule == nil {
		schedules = nil
		for _, mode := range []gkrcore.ConsolidationMode{gkrcore.ConsolidateAll, gkrcore.ConsolidateMultiClaimInputsOnly, gkrcore.ConsolidateNone} {
			s, err := gkrcore.DefaultProvingSchedule(sCircuit, mode)
			assert.NoError(t, err)
			schedules = append(schedules, s)
		}
	}

	ins := gCircuit.Inputs()
	insAssignment := make(WireAssignment, len(ins))
	maxSize := 1 << gkrtesting.GetLogMaxInstances(t)

	for i := range ins {
		insAssignment[i] = make([]{{ .ElementType }}, maxSize)
		{{ .FieldPackageName }}.Vector(insAssignment[i]).MustSetRandom()
	}

	fullAssignment := make(WireAssignment, len(circuit))
	for _, numEvals := range []int{2, maxSize} {
		for i := range ins {
			fullAssignment[ins[i]] = insAssignment[i][:numEvals]
		}

		fullAssignment.Complete(sCircuit)

		for _, s := range schedules {
			proveAndVerify(t, sCircuit, s, fullAssignment)
		}
	}
}

func testNoGate(t *testing.T, inputAssignments ...[]{{ .ElementType }}) {
	_, c := cache.Compile(t, gkrtesting.NoGateCircuit())

	schedule, err := gkrcore.DefaultProvingSchedule(c, gkrcore.ConsolidateNone)
	assert.NoError(t, err)

	assignment := WireAssignment{0: inputAssignments[0]}

	proveAndVerify(t, c, schedule, assignment)
}

func generateTestProver(path string) func(t *testing.T) {
	return func(t *testing.T) {
		testCase, err := newTestCase(path)
		assert.NoError(t, err)
		proof, _, err := Prove(testCase.Circuit, testCase.Schedule, testCase.FullAssignment, testCase.Hash)
		assert.NoError(t, err)
		assert.NoError(t, proofEquals(testCase.Proof, proof))
	}
}

func generateTestVerifier(path string) func(t *testing.T) {
	return func(t *testing.T) {
		testCase, err := newTestCase(path)
		assert.NoError(t, err)

		logNbInstances := testCase.InOutAssignment.NumVars()
		claims, err := Verify(testCase.Circuit, testCase.Schedule, logNbInstances, testCase.Proof, testCase.Hash)
		assert.NoError(t, err, "proof rejected")
		assert.NoError(t, claims.Check(testCase.InOutAssignment))

		claims, err = Verify(testCase.Circuit, testCase.Schedule, logNbInstances, testCase.Proof, newMessageCounter(2, 0))
		if err == nil {
			err = claims.Check(testCase.InOutAssignment)
		}
		assert.NotNil(t, err, "bad proof accepted")
	}
}

func TestGkrVectors(t *testing.T) {
	const testDirPath = "../../internal/gkr/test_vectors/"
	dirEntries, err := os.ReadDir(testDirPath)
	assert.NoError(t, err)
	for _, dirEntry := range dirEntries {
		if !dirEntry.IsDir() {

			if filepath.Ext(dirEntry.Name()) == ".json" {
				path := filepath.Join(testDirPath, dirEntry.Name())
				noExt := dirEntry.Name()[:len(dirEntry.Name())-len(".json")]

				t.Run(noExt+"_prover", generateTestProver(path))
				t.Run(noExt+"_verifier", generateTestVerifier(path))

			}
		}
	}
}

func proofEquals(expected Proof, seen Proof) error {
	if len(expected) != len(seen) {
		return fmt.Errorf("length mismatch %d ≠ %d", len(expected), len(seen))
	}
	for i, x := range expected {
		xSeen := seen[i]

		if xSeen.finalEvalProof == nil {
			if seenFinalEval := x.finalEvalProof; len(seenFinalEval) != 0 {
				return fmt.Errorf("length mismatch %d ≠ %d", 0, len(seenFinalEval))
			}
		} else {
			if err := sliceEquals(x.finalEvalProof, xSeen.finalEvalProof); err != nil {
				return fmt.Errorf("final evaluation proof mismatch")
			}
		}
		if err := polynomialSliceEquals(x.partialSumPolys, xSeen.partialSumPolys); err != nil {
			return err
		}
	}
	return nil
}

func benchmarkGkrMiMC(b *testing.B, nbInstances, mimcDepth int) {
	fmt.Println("creating circuit structure")
	_, c := cache.Compile(b, gkrtesting.MiMCCircuit(mimcDepth))

	schedule, err := gkrcore.DefaultProvingSchedule(c, gkrcore.ConsolidateNone)
	assert.NoError(b, err)

	in0 := make([]{{ .ElementType }}, nbInstances)
	in1 := make([]{{ .ElementType }}, nbInstances)
	{{ .FieldPackageName }}.Vector(in0).MustSetRandom()
	{{ .FieldPackageName }}.Vector(in1).MustSetRandom()

	fmt.Println("evaluating circuit")
	start := time.Now().UnixMicro()
	assignment := WireAssignment{in0, in1}.Complete(c)
	solved := time.Now().UnixMicro() - start
	fmt.Println("solved in", solved, "μs")

	//b.ResetTimer()
	fmt.Println("constructing proof")
	start = time.Now().UnixMicro()
	_, _, err = Prove(c, schedule, assignment, mimc.NewMiMC())
	proved := time.Now().UnixMicro() - start
	fmt.Println("proved in", proved, "μs")
	assert.NoError(b, err)
}

// TestSingleMulGateExplicitSchedule tests a single mul gate with an explicit single-step schedule,
// equivalent to the default but constructed manually to exercise the schedule path.
func TestSingleMulGateExplicitSchedule(t *testing.T) {
	circuit := gkrtesting.SingleMulGateCircuit()
	_, sCircuit := cache.Compile(t, circuit)

	// Wire 2 is the mul gate output (inputs: 0, 1).
	// Explicit schedule: an empty level 0 (consolidation), then one GkrProvingLevel for wire 2.
	// GkrClaimSource{Level:2} is the initial-challenge sentinel (len(schedule)=2).
	schedule := constraint.GkrProvingSchedule{
		&constraint.GkrSkipLevel{},
		&constraint.GkrSumcheckLevel{
			{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
		},
	}
	testWithSchedule(t, circuit, schedule)
	_ = sCircuit
}

// TestTwoGroupsExplicitSchedule tests a level with two single-wire claim groups sharing the same
// claim source. A default schedule never produces two groups here: same-degree wires with
// identical claim sources are always merged into one group.
func TestTwoGroupsExplicitSchedule(t *testing.T) {
	// Wires 0,1 = inputs; wires 2,3 = mul(0,1), both independent outputs.
	circuit := gkrcore.RawCircuit{
		{},
		{},
		{Gate: gkrcore.Mul2, Inputs: []int{0, 1}},
		{Gate: gkrcore.Mul2, Inputs: []int{0, 1}},
	}
	// An empty level 0 (consolidation), then one level, two claim groups, covering the whole
	// circuit. GkrClaimSource{Level:2} is the initial-challenge sentinel (len(schedule)=2).
	schedule := constraint.GkrProvingSchedule{
		&constraint.GkrSkipLevel{},
		&constraint.GkrSumcheckLevel{
			{Wires: []int{3}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
			{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
		},
	}
	testWithSchedule(t, circuit, schedule)
}

// TestMixedGroupsExplicitSchedule tests a level combining a single-wire claim group with a
// multi-wire one, both sharing the same claim source.
func TestMixedGroupsExplicitSchedule(t *testing.T) {
	// Wires 0,1 = inputs; wires 2,3,4 = mul(0,1), all independent outputs.
	circuit := gkrcore.RawCircuit{
		{},
		{},
		{Gate: gkrcore.Mul2, Inputs: []int{0, 1}},
		{Gate: gkrcore.Mul2, Inputs: []int{0, 1}},
		{Gate: gkrcore.Mul2, Inputs: []int{0, 1}},
	}
	// An empty level 0 (consolidation), then one level, two claim groups (one single-wire, one
	// two-wire), covering the whole circuit.
	schedule := constraint.GkrProvingSchedule{
		&constraint.GkrSkipLevel{},
		&constraint.GkrSumcheckLevel{
			{Wires: []int{4}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
			{Wires: []int{3, 2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
		},
	}
	testWithSchedule(t, circuit, schedule)
}

// TestConsolidationLevel tests a non-empty level 0: one group consolidating inputs 0 and 1, which
// share a single claim source (the mul gate's level), and a second group consolidating output 2,
// whose only claim source is the output level.
func TestConsolidationLevel(t *testing.T) {
	circuit := gkrtesting.SingleMulGateCircuit()
	// Wire 2 is the mul gate output (inputs: 0, 1), and the circuit's only output.
	// GkrClaimSource{Level:2} is the initial-challenge sentinel (len(schedule)=2).
	schedule := constraint.GkrProvingSchedule{
		&constraint.GkrSumcheckLevel{
			{Wires: []int{1, 0}, ClaimSources: []constraint.GkrClaimSource{ {Level: 1} }},
			{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
		},
		&constraint.GkrSingleSourceZeroCheckLevel{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2} }},
	}
	testWithSchedule(t, circuit, schedule)
}

// TestConsolidationLevelMultiSourceInput tests level 0 consolidating an input with two claim
// sources: wire 0 feeds two separate identity gates, each its own level and its own output.
func TestConsolidationLevelMultiSourceInput(t *testing.T) {
	circuit := gkrcore.RawCircuit{
		{},                                                        // wire 0: input
		{Gate: gkrcore.Identity, Inputs: []int{0}, Exported: true}, // wire 1
		{Gate: gkrcore.Identity, Inputs: []int{0}, Exported: true}, // wire 2
	}
	// GkrClaimSource{Level:3} is the initial-challenge sentinel (len(schedule)=3).
	schedule := constraint.GkrProvingSchedule{
		&constraint.GkrSumcheckLevel{
			{Wires: []int{0}, ClaimSources: []constraint.GkrClaimSource{ {Level: 2}, {Level: 1} }},
		},
		&constraint.GkrSkipLevel{Wires: []int{1}, ClaimSources: []constraint.GkrClaimSource{ {Level: 3} }},
		&constraint.GkrSkipLevel{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 3} }},
	}
	testWithSchedule(t, circuit, schedule)
}

// TestConsolidationLevelInternalOutput tests level 0 consolidating a non-input output that also
// feeds a downstream gate: wire 2's row is built once, at its own gate level (level 1), whose
// claim sources put the output level first (GkrClaimGroup's order); level 0 must reuse that same row
// rather than rebuild one of its own.
func TestConsolidationLevelInternalOutput(t *testing.T) {
	circuit := gkrcore.RawCircuit{
		{},                                                         // wire 0: input
		{},                                                         // wire 1: input
		{Gate: gkrcore.Mul2, Inputs: []int{0, 1}, Exported: true},   // wire 2: mul(0,1), exported, feeds wire 3
		{Gate: gkrcore.Identity, Inputs: []int{2}},                  // wire 3: identity(2), output
	}
	// GkrClaimSource{Level:3} is the initial-challenge sentinel (len(schedule)=3).
	schedule := constraint.GkrProvingSchedule{
		// Level 0: consolidates output 2, whose only claim source for level 0 is the output level.
		&constraint.GkrSkipLevel{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 3} }},
		// Level 1: mul gate output, exported and feeding wire 3 (level 2): the output level comes
		// first (GkrClaimGroup's order), then wire 3's level.
		&constraint.GkrSumcheckLevel{
			{Wires: []int{2}, ClaimSources: []constraint.GkrClaimSource{ {Level: 3}, {Level: 2} }},
		},
		// Level 2: identity(2), an output.
		&constraint.GkrSkipLevel{Wires: []int{3}, ClaimSources: []constraint.GkrClaimSource{ {Level: 3} }},
	}
	testWithSchedule(t, circuit, schedule)
}

