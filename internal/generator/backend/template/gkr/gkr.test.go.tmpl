// proveAndVerify proves and verifies assignment against schedule, then asserts that: every wire of
// schedule[0] has exactly one claim, and all of them share one point; the number of
// elements in the proof, counted with proof.Flatten(), equals c.ProofSize(schedule, logNbInstances);
// tampering instance 0 of any wire with claims makes Check fail; a bad hash makes Verify or Check
// fail; and tampering the first element of any finalEvalProof or partial sum polynomial in the
// proof, the output entry included, makes Verify reject it — except for the claimed evaluation of
// an output wire that is a circuit input outside schedule[0], which nothing in the proof cross-checks:
// there Verify must accept, and only Claims.Check catches the tampering.
func proveAndVerify(t *testing.T, c Circuit, schedule constraint.GkrProvingSchedule, assignment WireAssignment) {
	t.Helper()
	proof, proverClaims, err := Prove(c, schedule, assignment, newMessageCounter(1, 1))
	assert.NoError(t, err)
	assert.NoError(t, proverClaims.Check(assignment))

	logNbInstances := assignment.NumVars()
	verifierClaims, err := Verify(c, schedule, logNbInstances, proof, newMessageCounter(1, 1))
	assert.NoError(t, err, "proof rejected")
	assert.Equal(t, proverClaims, verifierClaims)
	assert.NoError(t, verifierClaims.Check(assignment))

	consolidated := c.LevelWires(schedule[0])
	var consolidationPoint []{{ .ElementType }}
	for wI, isConsolidated := range consolidated {
		if !isConsolidated {
			continue
		}
		if assert.Len(t, verifierClaims[wI], 1, "wire %d: expected exactly one claim", wI) {
			if consolidationPoint == nil {
				consolidationPoint = verifierClaims[wI][0].EvaluationPoint
			} else {
				assert.Equal(t, consolidationPoint, verifierClaims[wI][0].EvaluationPoint, "wire %d: expected the shared consolidation point", wI)
			}
		}
	}

	var nbProofElems int
	for range proof.Flatten() {
		nbProofElems++
	}
	assert.Equal(t, c.ProofSize(schedule, logNbInstances), nbProofElems)

	for wI := range verifierClaims {
		assignment[wI][0].Add(&assignment[wI][0], &one)
		assert.NotNil(t, verifierClaims.Check(assignment), "wire %d: tampered assignment accepted", wI)
		assignment[wI][0].Sub(&assignment[wI][0], &one)
	}

	badHashClaims, err := Verify(c, schedule, logNbInstances, proof, newMessageCounter(0, 1))
	if err == nil {
		err = badHashClaims.Check(assignment)
	}
	assert.NotNil(t, err, "bad proof accepted")

	for levelI := range proof {
		tamperTargets := [][]{{ .ElementType }}{proof[levelI].finalEvalProof}
		for _, p := range proof[levelI].partialSumPolys {
			tamperTargets = append(tamperTargets, p)
		}
		for _, target := range tamperTargets {
			if len(target) == 0 {
				continue
			}
			target[0].Add(&target[0], &one)
			claims, err := Verify(c, schedule, logNbInstances, proof, newMessageCounter(1, 1))
			if levelI < len(schedule) || !c.IsInput(c.Outputs()[0]) || consolidated[c.Outputs()[0]] {
				assert.Error(t, err, "tampered proof accepted at level %d", levelI)
			} else {
				assert.NoError(t, err, "level %d: Verify should accept a tampered claim it cannot cross-check", levelI)
				assert.Error(t, claims.Check(assignment), "level %d: tampered output claim accepted", levelI)
			}
			target[0].Sub(&target[0], &one)
		}
	}
}

